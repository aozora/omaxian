MULTICAST_GROUP = "224.0.0.167"
DEFAULT_PORT = 53317
PROTOCOL_VERSION = "2.1"
ANNOUNCE_INTERVAL = 6.0
DEVICE_TTL = 90.0
# Multicast between Wi-Fi clients is often filtered; probe local subnets this
# often so peers that answer on TCP still show up in the panel.
SCAN_EVERY_TICKS = 5
ASK_TIMEOUT = 60.0
# Ceiling on a peer's response body. A prepare-upload answer is a few hundred
# bytes; nothing a peer legitimately sends us comes close to this.
MAX_RESPONSE_BYTES = 1 << 20
# A chunked body ends with optional trailers; more than a handful is a peer
# holding the connection open rather than finishing.
MAX_TRAILER_LINES = 32
# Anyone on the network can announce themselves, so the table they land in is
# bounded and evicts whoever was heard from longest ago.
MAX_DEVICES = 64
# One transfer's worth of files, and the free space to keep underneath it.
MAX_FILES_PER_SESSION = 512
DISK_MARGIN = 256 << 20
# Every file must declare a size in (0, MAX_FILE_BYTES], and a session's files
# together may not exceed MAX_SESSION_BYTES. A missing or zero size used to mean
# "unknown", which lifted the streaming cap to 8 GiB.
MAX_FILE_BYTES = 64 << 30
MAX_SESSION_BYTES = 256 << 30
# How often, in bytes written, a receive re-checks the free space underneath it.
DISK_RECHECK_BYTES = 8 << 20

# Receive-server deadlines. Anyone on the network can connect, so no request
# phase may hold a thread or socket open on the peer's schedule.
MAX_CONNECTIONS = 16        # concurrent handlers; extra connections are closed
IO_TIMEOUT = 20.0           # any single read or write that makes no progress
HEADER_DEADLINE = 15.0      # accept → request line and headers complete
BODY_DEADLINE = 20.0        # a JSON request body, start to finish
REPLY_DEADLINE = 15.0       # writing our answer
UPLOAD_BASE_DEADLINE = 60.0 # an upload gets this long plus...
UPLOAD_MIN_RATE = 256 << 10 # ...one second per this many declared bytes
STALL_TIMEOUT = 60.0
MAX_TRANSFERS = 10
NOTIFY_GLYPH = "󰀂"
# Fired once per landed file into hooks/local-drop-received[.d/]
HOOK_NAME = "local-drop-received"


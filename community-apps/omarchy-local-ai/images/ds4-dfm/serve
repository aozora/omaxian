#!/bin/sh
# Caddy on 8080 checks the key and passes requests to ds4-server on loopback, which gets this
# script's arguments. The root is read-only: what either writes goes under /tmp.
set -eu
if [ -z "${DS4_API_KEY:-}" ]; then
  echo "serve: DS4_API_KEY is empty" >&2
  exit 1
fi
export HOME=/tmp
caddy run --config /etc/caddy/Caddyfile --adapter caddyfile &
exec ds4-server --host 127.0.0.1 --port 8081 "$@"

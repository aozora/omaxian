# The key check in front of ds4-server, which has none of its own: every route needs the key in
# DS4_API_KEY, and the rest streams to the server on loopback as it comes.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	@refused not header Authorization "Bearer {$DS4_API_KEY}"
	respond @refused 401
	reverse_proxy 127.0.0.1:8081 {
		flush_interval -1
	}
}

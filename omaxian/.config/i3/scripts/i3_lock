#!/usr/bin/env bash

## Screen lock for i3 / Devuan (elogind). Prefer a real locker; loginctl alone
## often no-ops unless xss-lock or a screensaver is registered.
##
## Under picom glx, locking with a live Quickshell bar has crashed QS on
## unlock (I3 "Refreshing Monitors…" / dangling screen). Stop picom for the
## duration of the lock — same rule as omarchy-restart-shell — and tell the
## display watcher not to modeset until we are unlocked.

notify_fail() {
	command -v dunstify >/dev/null 2>&1 \
		&& dunstify -u normal "Screen lock failed" \
			"Install i3lock (and i3lock-omaxian / i3lock-fancy) or start xfce4-screensaver."
}

detect_wm() {
	if pgrep -x i3 >/dev/null 2>&1; then
		echo i3
	elif [[ "${XDG_CURRENT_DESKTOP:-}" == *[Xx][Ff][Cc][Ee]* ]] \
		|| [[ "${DESKTOP_SESSION:-}" == *[Xx][Ff][Cc][Ee]* ]] \
		|| pgrep -x xfce4-session >/dev/null 2>&1; then
		echo xfce
	else
		echo generic
	fi
}

LOCK_FLAG="${XDG_RUNTIME_DIR:-/tmp}/omaxian-screen-locked"
COMP="${HOME}/.config/i3/scripts/i3_comp"
BAR="${HOME}/.config/i3/scripts/i3_bar"
_picom_was_running=0

mark_locked() {
	[[ -n ${XDG_RUNTIME_DIR:-} ]] || return 0
	: >"$LOCK_FLAG" 2>/dev/null || true
}

clear_locked() {
	rm -f "$LOCK_FLAG" 2>/dev/null || true
}

stop_picom() {
	if pgrep -u "$UID" -x picom >/dev/null 2>&1; then
		_picom_was_running=1
		pkill -u "$UID" -x picom 2>/dev/null || true
		local _
		for _ in $(seq 1 40); do
			pgrep -u "$UID" -x picom >/dev/null 2>&1 || return 0
			sleep 0.05
		done
		pkill -9 -u "$UID" -x picom 2>/dev/null || true
	fi
}

start_picom() {
	(( _picom_was_running )) || return 0
	_picom_was_running=0
	[[ -x $COMP ]] || return 0
	"$COMP" >/dev/null 2>&1 || true
}

ensure_bar() {
	[[ -x $BAR ]] || return 0
	"$BAR" >/dev/null 2>&1 || true
}

# Always restore compositor / clear the lock flag, even if the locker fails.
cleanup() {
	clear_locked
	start_picom
	ensure_bar
}
trap cleanup EXIT

try_xfce_screensaver() {
	command -v xfce4-screensaver-command >/dev/null 2>&1 \
		|| return 1
	# Leave picom alone for XFCE's own locker.
	xfce4-screensaver-command -l 2>/dev/null
}

try_i3lock_omaxian() {
	command -v i3lock-omaxian >/dev/null 2>&1 || return 1
	command -v i3lock >/dev/null 2>&1 || return 1

	mark_locked
	stop_picom
	# Blocks until unlock (i3lock -n); cleanup trap restores picom.
	i3lock-omaxian
}

try_i3lock_fancy() {
	command -v i3lock-fancy >/dev/null 2>&1 || return 1
	command -v i3lock >/dev/null 2>&1 || return 1

	mark_locked
	stop_picom
	# Debian's i3lock-fancy ignores trailing screenshot args and uses
	# ImageMagick `import`; it already runs `i3lock -n` (blocks until unlock).
	i3lock-fancy
}

try_i3lock() {
	command -v i3lock >/dev/null 2>&1 || return 1
	mark_locked
	stop_picom
	# -n: stay in foreground until unlock so cleanup runs afterward.
	i3lock -n -e -f -c 1e1e2e
}

try_slock() {
	command -v slock >/dev/null 2>&1 || return 1
	mark_locked
	stop_picom
	slock
}

try_loginctl() {
	command -v loginctl >/dev/null 2>&1 || return 1
	# Only useful when xss-lock / screensaver registered a session lock handler
	loginctl lock-session 2>/dev/null
}

case "$(detect_wm)" in
	xfce)
		command -v xflock4 >/dev/null 2>&1 && exec xflock4
		;;
esac

try_xfce_screensaver && exit 0
try_i3lock_omaxian && exit 0
try_i3lock_fancy && exit 0
try_i3lock && exit 0
try_slock && exit 0
try_loginctl && exit 0

notify_fail
exit 1

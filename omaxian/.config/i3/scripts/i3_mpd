#!/usr/bin/env bash
# Start MPD for the i3 session (user config in ~/.mpd/mpd.conf).

CONF="${HOME}/.mpd/mpd.conf"
PID_FILE="${HOME}/.mpd/mpd.pid"

command -v mpd >/dev/null 2>&1 || exit 0
[[ -r "$CONF" ]] || exit 0

mkdir -p "${HOME}/.mpd/playlists"

if [[ -f "$PID_FILE" ]]; then
	pid="$(<"$PID_FILE")"
	if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
		exit 0
	fi
	rm -f "$PID_FILE"
fi

# Pulse/PipeWire may not be ready the moment i3 autostart runs.
for _ in {1..20}; do
	pactl info &>/dev/null && break
	sleep 0.25
done

mpd "$CONF" 2>/dev/null || true

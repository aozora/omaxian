# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0B0517"

# Main text color
theme[main_fg]="#E9D6E7"

# Title color for boxes
theme[title]="#E9D6E7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8773b5"

# Background color of selected item in processes box. #231e2e maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #231e2e gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#231e2e"

# Foreground color of selected item in processes box. Use #E9D6E7 so
# the row text stays readable on the lighter_bg highlight; the previous
# #8773b5 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#E9D6E7"

# Color of inactive/disabled text
theme[inactive_fg]="#605f65"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #ecdceb caps at #ffffff when the foreground is already pure white, so we
# just bind it to #E9D6E7 directly.
theme[graph_text]="#E9D6E7"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #231e2e collapsed to the main fg.
theme[meter_bg]="#231e2e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #c6d0ff for a distinct accent instead of #ecdceb which capped to white.
theme[proc_misc]="#c6d0ff"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c695e2"
theme[mem_box]="#a0c2ff"
theme[net_box]="#b582b1"
theme[proc_box]="#8773b5"

# Box divider line and small boxes line color
theme[div_line]="#605f65"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#a0c2ff"
theme[temp_mid]="#ffcdff"
theme[temp_end]="#b582b1"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#c6d0ff"
theme[cpu_mid]="#8773b5"
theme[cpu_end]="#c695e2"

# Mem/Disk free meter
theme[free_start]="#c695e2"
theme[free_mid]="#8773b5"
theme[free_end]="#c6d0ff"

# Mem/Disk cached meter
theme[cached_start]="#8773b5"
theme[cached_mid]="#c6d0ff"
theme[cached_end]="#c695e2"

# Mem/Disk available meter
theme[available_start]="#ffcdff"
theme[available_mid]="#b582b1"
theme[available_end]="#b582b1"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#a0c2ff"
theme[used_mid]="#c6d0ff"
theme[used_end]="#8773b5"

# Download graph colors
theme[download_start]="#ffcdff"
theme[download_mid]="#b582b1"
theme[download_end]="#b582b1"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#a0c2ff"
theme[upload_mid]="#c6d0ff"
theme[upload_end]="#8773b5"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#c6d0ff"
theme[process_mid]="#8773b5"
theme[process_end]="#c695e2"

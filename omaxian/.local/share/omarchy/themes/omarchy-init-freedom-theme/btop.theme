# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#010608"

# Main text color
theme[main_fg]="#A6D5D0"

# Title color for boxes
theme[title]="#A6D5D0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#5f8491"

# Background color of selected item in processes box. #1a1f21 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1f21 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1f21"

# Foreground color of selected item in processes box. Use #A6D5D0 so
# the row text stays readable on the lighter_bg highlight; the previous
# #5f8491 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#A6D5D0"

# Color of inactive/disabled text
theme[inactive_fg]="#61696b"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #b3dbd7 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #A6D5D0 directly.
theme[graph_text]="#A6D5D0"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #1a1f21 collapsed to the main fg.
theme[meter_bg]="#1a1f21"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #a4e4ea for a distinct accent instead of #b3dbd7 which capped to white.
theme[proc_misc]="#a4e4ea"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#88afc8"
theme[mem_box]="#9acbc6"
theme[net_box]="#7d9b8b"
theme[proc_box]="#5f8491"

# Box divider line and small boxes line color
theme[div_line]="#61696b"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#9acbc6"
theme[temp_mid]="#c3fcf1"
theme[temp_end]="#7d9b8b"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#a4e4ea"
theme[cpu_mid]="#5f8491"
theme[cpu_end]="#88afc8"

# Mem/Disk free meter
theme[free_start]="#88afc8"
theme[free_mid]="#5f8491"
theme[free_end]="#a4e4ea"

# Mem/Disk cached meter
theme[cached_start]="#5f8491"
theme[cached_mid]="#a4e4ea"
theme[cached_end]="#88afc8"

# Mem/Disk available meter
theme[available_start]="#c3fcf1"
theme[available_mid]="#7d9b8b"
theme[available_end]="#7d9b8b"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#9acbc6"
theme[used_mid]="#a4e4ea"
theme[used_end]="#5f8491"

# Download graph colors
theme[download_start]="#c3fcf1"
theme[download_mid]="#7d9b8b"
theme[download_end]="#7d9b8b"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#9acbc6"
theme[upload_mid]="#a4e4ea"
theme[upload_end]="#5f8491"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#a4e4ea"
theme[process_mid]="#5f8491"
theme[process_end]="#88afc8"

{
  "schemaVersion": 1,
  "id": "omarchy.spacer",
  "name": "Spacer",
  "version": "1.0.0",
  "author": "Omarchy",
  "description": "Configurable blank space",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Spacer.qml"
  },
  "barWidget": {
    "displayName": "Spacer",
    "description": "Configurable blank space",
    "category": "Layout",
    "allowMultiple": true,
    "settingsForm": "spacerSettings",
    "schema": [
      {
        "key": "size",
        "type": "integer",
        "label": "Size",
        "description": "Blank space in pixels along the bar.",
        "defaultValue": 12,
        "from": 0,
        "to": 200
      }
    ]
  }
}

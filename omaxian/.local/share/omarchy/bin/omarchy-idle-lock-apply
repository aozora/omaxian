#!/bin/bash

# omarchy:summary=Apply idle auto-lock (xss-lock + xset) from shell.json
# omarchy:group=system
# omarchy:args=[]
# omarchy:examples=omarchy-idle-lock-apply

set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
STOCK="$OMARCHY_PATH/shell.json"
STATE_FILE="$HOME/.local/state/omarchy/indicators/stay-awake"
LOCK="${HOME}/.config/i3/scripts/i3_lock"
LOCKER="omarchy-system-lock"

stay_awake_on() {
  [[ -f $STATE_FILE ]] || return 1
  local v
  v=$(tr -d '[:space:]' <"$STATE_FILE" 2>/dev/null || true)
  # Service writes 0/1; omarchy-toggle-idle may touch an empty file (= on).
  [[ $v != "0" ]]
}

read_idle() {
  local path=$1
  [[ -f $path ]] || return 1
  IDLE_JSON=$(
    CONFIG_PATH="$path" python3 - <<'PY'
import json, os, sys
path = os.environ["CONFIG_PATH"]
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit(1)
idle = data.get("idle") if isinstance(data, dict) else None
if not isinstance(idle, dict):
    idle = {}
raw = idle.get("enabled", False)
if isinstance(raw, str):
    enabled = raw.strip().lower() in ("1", "true", "yes", "on")
else:
    enabled = bool(raw)
lock = idle.get("lock", 300)
try:
    lock = int(lock)
except Exception:
    lock = 300
if lock < 30:
    lock = 30
if lock > 86400:
    lock = 86400
print("1" if enabled else "0")
print(lock)
PY
  ) || return 1
  IDLE_ENABLED=$(printf '%s\n' "$IDLE_JSON" | sed -n '1p')
  IDLE_LOCK=$(printf '%s\n' "$IDLE_JSON" | sed -n '2p')
}

IDLE_ENABLED=0
IDLE_LOCK=300
if ! read_idle "$CONFIG"; then
  read_idle "$STOCK" || true
fi

apply_xset() {
  command -v xset >/dev/null 2>&1 || return 0
  # Reset any pending screensaver activation before arming/disarming so a
  # freshly started xss-lock cannot immediately run the locker (which stops
  # picom and can take down Quickshell under glx during login).
  xset s reset >/dev/null 2>&1 || true

  if stay_awake_on; then
    xset s off -dpms >/dev/null 2>&1 || true
    return 0
  fi

  if [[ $IDLE_ENABLED == "1" ]]; then
    xset s "$IDLE_LOCK" "$IDLE_LOCK" >/dev/null 2>&1 || true
    xset s on >/dev/null 2>&1 || true
    xset +dpms >/dev/null 2>&1 || true
    xset dpms "$IDLE_LOCK" "$IDLE_LOCK" "$IDLE_LOCK" >/dev/null 2>&1 || true
  else
    # xss-lock may still handle logind Lock; do not arm screensaver idle lock.
    xset s off >/dev/null 2>&1 || true
  fi
}

ensure_xss_lock() {
  command -v xss-lock >/dev/null 2>&1 || return 0
  if pgrep -u "$UID" -x xss-lock >/dev/null 2>&1; then
    return 0
  fi
  local cmd=()
  # Prefer i3_lock (full fallback chain). Never point xss-lock at i3lock-omaxian
  # without i3lock — a failing locker loop is worse than no auto-lock.
  if [[ -x $LOCK ]]; then
    cmd=("$LOCK")
  elif command -v "$LOCKER" >/dev/null 2>&1; then
    cmd=("$LOCKER")
  elif command -v i3lock >/dev/null 2>&1 && command -v i3lock-omaxian >/dev/null 2>&1; then
    cmd=(i3lock-omaxian)
  elif command -v i3lock >/dev/null 2>&1; then
    cmd=(i3lock -n -e -f -c 1e1e2e)
  elif command -v slock >/dev/null 2>&1; then
    cmd=(slock)
  else
    return 0
  fi
  # -l: transfer sleep lock; locker runs on screensaver / logind Lock.
  # Must run AFTER apply_xset so we never attach xss-lock to an already-active
  # or imminent screensaver during session start.
  xss-lock -l -- "${cmd[@]}" >/dev/null 2>&1 &
  disown || true
}

# Stop leftover XFCE locker daemons. OnlyShowIn=XFCE is ignored when something
# dbus-activates org.xfce.ScreenSaver; sleep-activation then locks beside
# xss-lock → unlock i3lock-omaxian, then unlock the XFCE dialog again.
stop_xfce_screensaver() {
  pkill -u "$UID" -x xfce4-screensaver 2>/dev/null || true
}

# xfce4-power-manager (started from i3_autostart) locks before suspend via
# libxfce4ui's xfce_screensaver_lock(). Without a LockCommand it tries XFCE /
# xdg / xscreensaver / light-locker — all fail under bare i3 and pop:
# "None of the screen lock tools ran successfully…". xss-lock -l already owns
# PrepareForSleep, so turn off xfpm's redundant pre-suspend lock and point
# session LockCommand at loginctl so any remaining XFCE lock UI delegates here.
configure_xfce_lock_delegation() {
  command -v xfconf-query >/dev/null 2>&1 || return 0

  if command -v loginctl >/dev/null 2>&1; then
    xfconf-query -c xfce4-session -p /general/LockCommand -n -t string \
      -s "loginctl lock-session" >/dev/null 2>&1 || true
  fi

  if command -v xss-lock >/dev/null 2>&1; then
    xfconf-query -c xfce4-power-manager \
      -p /xfce4-power-manager/lock-screen-suspend-hibernate -n -t bool -s false \
      >/dev/null 2>&1 || true
    # Bound to the same lock-on-sleep GObject prop; set explicitly in case xfpm
    # is not running yet to propagate the binding.
    xfconf-query -c xfce4-screensaver -p /lock/sleep-activation -n -t bool -s false \
      >/dev/null 2>&1 || true
    xfconf-query -c xfce4-session -p /shutdown/LockScreen -n -t bool -s false \
      >/dev/null 2>&1 || true
  fi
}

stop_xfce_screensaver
configure_xfce_lock_delegation
apply_xset
ensure_xss_lock

exit 0

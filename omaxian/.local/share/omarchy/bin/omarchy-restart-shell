#!/bin/bash

# omarchy:summary=Restart the Omarchy Quickshell host (X11 port)
# omarchy:examples=omarchy-restart-shell
#
# Hard-stop supervisor + quickshell, then start one fresh omarchy-launch-shell.
#
# CRITICAL (glx picom): destroying Quickshell's ARGB windows while picom's
# glx backend is still compositing freezes or tears down the X session.
# This script MUST:
#   1. Stop picom and verify it is gone
#   2. Kill the shell and wait until ping fails / processes are gone
#   3. Start exactly one new launch-shell
#   4. Bring picom back (EXIT trap — even on failure)
# Never kill QS while picom is alive. Never start a second launch while the
# old shell still answers ping (that race is what FAILED + crashed sessions).

set -euo pipefail

export OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
case ":$PATH:" in
  *":$OMARCHY_PATH/bin:"*) ;;
  *) export PATH="$OMARCHY_PATH/bin:$PATH" ;;
esac

# Prefer the real session runtime dir — never fall back to /tmp when
# /run/user/$UID exists, or restart/launch take different flock paths.
if [[ -z ${XDG_RUNTIME_DIR:-} && -d /run/user/$UID ]]; then
  export XDG_RUNTIME_DIR=/run/user/$UID
fi

CONFIG_DIR="$OMARCHY_PATH/shell"
LOG="$HOME/.local/state/omarchy/shell.log"
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-$UID"
LOCK_FILE="$LOCK_DIR/launch-shell.lock"
PID_FILE="$LOCK_DIR/launch-shell.pid"
RESTART_LOCK="$LOCK_DIR/restart-shell.lock"
COMP="$HOME/.config/i3/scripts/i3_comp"

[[ -f $CONFIG_DIR/shell.qml ]] || { echo "omarchy shell config not found: $CONFIG_DIR" >&2; exit 1; }
mkdir -p "$(dirname "$LOG")" "$LOCK_DIR"

log() {
  # Child has stdout already appended to $LOG — do not tee (that doubles lines).
  echo "omarchy-restart-shell: $*"
  if [[ -t 1 ]]; then
    echo "omarchy-restart-shell: $*" >>"$LOG"
  fi
}

# QS 0.3.0's execDetached (menu → this script) does not fully detach: killing
# quickshell can SIGHUP this process before relaunch. Re-enter under setsid.
if [[ ${OMARCHY_RESTART_DETACHED:-} != 1 ]]; then
  echo "omarchy-restart-shell: detaching before stop/relaunch…" | tee -a "$LOG"
  setsid -f env OMARCHY_RESTART_DETACHED=1 OMARCHY_PATH="$OMARCHY_PATH" PATH="$PATH" \
    ${DISPLAY:+DISPLAY="$DISPLAY"} ${I3SOCK:+I3SOCK="$I3SOCK"} \
    ${DBUS_SESSION_BUS_ADDRESS:+DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS"} \
    ${XDG_RUNTIME_DIR:+XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR"} \
    "$0" "$@" >>"$LOG" 2>&1
  exit 0
fi

# Serialize restarts. Block up to 90s so a double menu click cannot interleave
# two picom-stop / qs-kill sequences (that has taken X down).
exec 9>"$RESTART_LOCK"
if ! flock -w 90 9; then
  log "another restart is still running after 90s — giving up"
  exit 1
fi

picom_was_running=0
picom_stopped_by_us=0

picom_alive() {
  pgrep -u "$UID" -x picom >/dev/null 2>&1
}

shell_ping_ok() {
  omarchy-shell -q shell ping >/dev/null 2>&1
}

shell_procs_alive() {
  pgrep -u "$UID" -f 'omarchy-launch-shell' >/dev/null 2>&1 \
    || pgrep -u "$UID" -f "quickshell .*-p ${CONFIG_DIR}" >/dev/null 2>&1
}

stop_picom() {
  picom_alive || return 0
  picom_was_running=1
  log "stopping picom (glx + qs teardown freezes X)"
  pkill -u "$UID" -x picom 2>/dev/null || true
  local _
  for _ in $(seq 1 80); do
    picom_alive || { picom_stopped_by_us=1; return 0; }
    sleep 0.1
  done
  pkill -9 -u "$UID" -x picom 2>/dev/null || true
  sleep 0.3
  if picom_alive; then
    log "FAILED — could not stop picom; refusing to kill Quickshell (would crash X)"
    return 1
  fi
  picom_stopped_by_us=1
  return 0
}

start_picom() {
  [[ -x $COMP ]] || return 0
  if picom_alive; then
    return 0
  fi
  "$COMP" >/dev/null 2>&1 || true
}

# Always put the compositor back if we took it down — including on abort.
cleanup() {
  if (( picom_stopped_by_us )) || (( picom_was_running )); then
    start_picom
  fi
}
trap cleanup EXIT

# Always tear down leftovers; only relaunch inside a live i3 session.
allow_start=0
if omarchy-session-is-i3; then
  allow_start=1
else
  log "not an i3 session — stopping shell only (no relaunch)"
fi

# --- Phase 1: picom must be confirmed dead before any QS window destroy -----
if ! stop_picom; then
  exit 1
fi
# Brief settle so glx releases QS pixmaps before we tear windows down.
sleep 0.4
if picom_alive; then
  log "FAILED — picom respawned before shell kill; refusing to proceed"
  exit 1
fi

# --- Phase 2: kill shell and wait until it is actually gone -----------------
log "stopping old shell…"

if [[ -f $PID_FILE ]]; then
  old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [[ -n ${old_pid:-} ]] && kill -0 "$old_pid" 2>/dev/null; then
    kill -TERM "$old_pid" 2>/dev/null || true
  fi
fi

if [[ -f $LOCK_FILE ]]; then
  fuser -k -TERM "$LOCK_FILE" >/dev/null 2>&1 || true
fi

pkill -u "$UID" -f 'omarchy-launch-shell' 2>/dev/null || true
# Prefer quickshell's own kill while picom is down (graceful ARGB teardown).
while timeout 3 quickshell kill -p "$CONFIG_DIR" >/dev/null 2>&1; do
  sleep 0.1
done
pkill -u "$UID" -f "quickshell .*-p ${CONFIG_DIR}" 2>/dev/null || true

shell_gone=0
for _ in $(seq 1 100); do
  if ! shell_procs_alive && ! shell_ping_ok; then
    shell_gone=1
    break
  fi
  if (( _ == 40 )); then
    pkill -9 -u "$UID" -f 'omarchy-launch-shell' 2>/dev/null || true
    pkill -9 -u "$UID" -f "quickshell .*-p ${CONFIG_DIR}" 2>/dev/null || true
    fuser -k -KILL "$LOCK_FILE" >/dev/null 2>&1 || true
  fi
  sleep 0.1
done

rm -f "$PID_FILE"

if (( ! shell_gone )); then
  log "FAILED — old shell still alive after kill; not starting a second copy"
  log "FAILED — leaving session as-is and restoring picom (see $LOG)"
  exit 1
fi

# Drop a stale lock file so the next launch-shell does not see a dead holder.
rm -f "$LOCK_FILE"
sleep 0.2

# Picom must STILL be down (nothing else may have restarted it).
if picom_alive; then
  log "FAILED — picom came back before relaunch; stopping it again"
  if ! stop_picom; then
    exit 1
  fi
  sleep 0.3
fi

if (( ! allow_start )); then
  log "stopped (no relaunch outside i3)"
  exit 0
fi

# --- Phase 3: exactly one new supervisor ------------------------------------
if sock="$(i3 --get-socketpath 2>/dev/null)" && [[ -S $sock ]]; then
  export I3SOCK="$sock"
fi

log "starting omarchy-launch-shell (I3SOCK=${I3SOCK:-<unset>})…"
setsid nohup env \
  QS_WIDGETS_ONLY="${QS_WIDGETS_ONLY:-1}" \
  OMARCHY_PATH="$OMARCHY_PATH" \
  ${I3SOCK:+I3SOCK="$I3SOCK"} \
  ${XDG_RUNTIME_DIR:+XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR"} \
  ${DBUS_SESSION_BUS_ADDRESS:+DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS"} \
  ${DISPLAY:+DISPLAY="$DISPLAY"} \
  omarchy-launch-shell >>"$LOG" 2>&1 &

ready=0
for _ in $(seq 1 80); do
  if shell_ping_ok; then
    if [[ -f $PID_FILE ]] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
      ready=1
      break
    fi
  fi
  sleep 0.1
done

if (( ready )); then
  log "ready"
  exit 0
fi

log "shell did not become ready after restart."
log "FAILED — see $LOG"
exit 1

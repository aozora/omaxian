#!/bin/bash

# omarchy:summary=Select and set the system timezone
# omarchy:group=menu
# omarchy:name=timezone
#
# Devuan/elogind: no timedatectl. Lists via omarchy-timezone-list and sets via
# omarchy-timezone-set (/etc/timezone + /etc/localtime through pkexec/sudo).

set -euo pipefail

timezone=$(omarchy-timezone-list | omarchy-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
[[ -n $timezone ]] || exit 1

omarchy-timezone-set "$timezone"
omarchy-notification-send "Timezone is now set to $timezone"

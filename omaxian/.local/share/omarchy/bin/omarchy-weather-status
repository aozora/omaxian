#!/bin/bash

# omarchy:summary=Returns a formatted weather status string with temperature and wind speed.

set -o pipefail

place=$(omarchy-weather-location 2>/dev/null)

if [[ -z $place ]]; then
  echo "Weather unavailable"
  exit 1
fi

query=$(jq -rn --arg place "$place" '$place | @uri')

curl_bin=curl
head_bin=head
[[ -x /usr/bin/curl ]] && curl_bin=/usr/bin/curl
[[ -x /usr/bin/head ]] && head_bin=/usr/bin/head

weather=$("$curl_bin" -q -fsS --proto '=https' --proto-redir '=https' \
  --max-time 4 --max-filesize 4096 --noproxy '*' -- \
  "https://wttr.in/${query}?format=%t|%w" 2>/dev/null | "$head_bin" -c 4097) || true
weather=${weather//$'\n'/}

if [[ -z $weather ]] || (( ${#weather} > 4096 )); then
  echo "Weather unavailable"
  exit 1
fi

IFS='|' read -r temperature wind <<< "$weather"
place=${place^}
temperature=${temperature#+}

echo "$place  ·  Temp $temperature  ·  Wind $wind"

#!/bin/bash

# omarchy:summary=Open a folder in the system default file manager
# omarchy:group=launch
# omarchy:args=[path]
# omarchy:examples=omarchy-launch-files | omarchy-launch-files ~/Downloads
#
# Distro-agnostic: prefers XDG inode/directory handler (Nautilus, Thunar, …).
# Override with OMARCHY_FILE_MANAGER (command name or path).

set -euo pipefail

target=${1:-$HOME}
if [[ ! -e $target ]]; then
  echo "omarchy-launch-files: path not found: $target" >&2
  exit 1
fi
if command -v realpath >/dev/null 2>&1; then
  target=$(realpath -- "$target")
elif command -v readlink >/dev/null 2>&1; then
  target=$(readlink -f -- "$target" 2>/dev/null || printf '%s' "$target")
fi

notify_fail() {
  local err=$1
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -u critical "File manager" "$err" >/dev/null 2>&1 || true
  fi
  echo "omarchy-launch-files: $err" >&2
}

# 1. Explicit override (e.g. OMARCHY_FILE_MANAGER=nautilus).
if [[ -n ${OMARCHY_FILE_MANAGER:-} ]]; then
  # shellcheck disable=SC2086
  exec $OMARCHY_FILE_MANAGER "$target"
fi

# 2. Desktop entry registered for directories (inode/directory).
desktop=""
if command -v xdg-mime >/dev/null 2>&1; then
  desktop=$(xdg-mime query default inode/directory 2>/dev/null || true)
fi

launch_desktop() {
  local desk=$1
  local id=${desk%.desktop}

  if command -v gtk-launch >/dev/null 2>&1; then
    # gtk-launch accepts the .desktop basename; extra args are URIs/paths.
    gtk-launch "$desk" "$target" >/dev/null 2>&1 && return 0
    gtk-launch "$id" "$target" >/dev/null 2>&1 && return 0
  fi

  if command -v gio >/dev/null 2>&1; then
    local found=""
    local dir
    for dir in \
      "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
      /usr/local/share/applications \
      /usr/share/applications; do
      if [[ -f $dir/$desk ]]; then
        found=$dir/$desk
        break
      fi
    done
    if [[ -n $found ]]; then
      gio launch "$found" "$target" >/dev/null 2>&1 && return 0
    fi
  fi

  return 1
}

if [[ -n $desktop ]]; then
  if launch_desktop "$desktop"; then
    exit 0
  fi
fi

# 3. Generic XDG / GIO open (uses the same mime default when given a directory).
if command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open "$target"
fi
if command -v gio >/dev/null 2>&1; then
  exec gio open "$target"
fi

# 4. Last-resort known file managers (no preferred order beyond commonality).
for fm in nautilus thunar pcmanfm nemo dolphin caja; do
  if command -v "$fm" >/dev/null 2>&1; then
    exec "$fm" "$target"
  fi
done

notify_fail "no file manager found (set OMARCHY_FILE_MANAGER or install one)"
exit 1

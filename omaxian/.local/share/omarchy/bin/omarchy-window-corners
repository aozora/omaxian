#!/bin/bash

# omarchy:summary=Show or set window corners: theme, sharp, or rounded
# omarchy:args=[theme|sharp|rounded]
# omarchy:examples=omarchy-window-corners | omarchy-window-corners rounded

set -euo pipefail

STATE_FILE="$HOME/.local/state/omarchy/toggles/window-corners"

if (( $# == 0 )); then
  mode=$(cat "$STATE_FILE" 2>/dev/null || true)
  case $mode in
    sharp | rounded) echo "$mode" ;;
    *) echo "theme" ;;
  esac
  exit 0
fi

case $1 in
  theme) label=corners.followTheme ;;
  sharp) label=corners.sharp ;;
  rounded) label=corners.rounded ;;
  *)
    echo "Usage: omarchy-window-corners [theme|sharp|rounded]" >&2
    exit 1
    ;;
esac

mkdir -p "$(dirname "$STATE_FILE")"
printf '%s\n' "$1" >"$STATE_FILE"

omarchy-window-style-apply
omarchy-notification-send -g 󰘇 "$(omarchy-i18n "$label")" || true

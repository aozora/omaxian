#!/bin/bash

# omarchy:summary=Launch the default editor selected via Omarchy defaults
# omarchy:args=[--inline] <path>

: "${OMARCHY_PATH:=$HOME/.local/share/omarchy}"

default_editor="$HOME/.local/state/omarchy/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="plain"
fi

# sublime-text-4 ships `subl` on PATH, not `sublime_text`.
[[ $editor == sublime_text ]] && editor=subl

omarchy-cmd-present "$editor" || editor="nvim"

# Plain is a window, so a session without a display (SSH, a TTY) edits in vi
# instead, which every install has.
[[ ${editor##*/} == plain && -z ${DISPLAY:-} ]] && editor="vi"

case "${editor##*/}" in
plain)
  # Plain runs until its window closes, so $EDITOR (git commit, sudoedit)
  # waits for it inline.
  if [[ $inline == "true" ]]; then
    exec "$editor" -- "$@"
  else
    exec setsid -f "$editor" -- "$@"
  fi
  ;;
nvim | vim | vi | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" -- "$@"
  else
    term="${HOME}/.config/i3/scripts/i3_term"
    if [[ -x $term ]]; then
      exec "$term" --float -e "$editor" -- "$@"
    fi
    exec xdg-terminal-exec -- "$editor" -- "$@" 2>/dev/null || exec kitty -e "$editor" -- "$@"
  fi
  ;;
*)
  exec setsid -f "$editor" -- "$@"
  ;;
esac

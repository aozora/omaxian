#!/bin/bash

# omarchy:summary=Launch a floating terminal and run a command
# omarchy:args=<command>
#
# X11/i3: upstream uses uwsm-app + xdg-terminal-exec + gum presentation.
# Here: kitty-float via i3_term, then a keypress to dismiss.

set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: omarchy-launch-floating-terminal-with-presentation <command>" >&2
  exit 1
fi

# bash -lc rebuilds PATH from the login profile and drops $OMARCHY_PATH/bin
# (set by ~/.xsessionrc for the X session). Same fix as Util.loginShellCommand
# in the Quickshell shell — without it, menu actions like omarchy-plugin-remove
# fail with "command not found".
: "${OMARCHY_PATH:=$HOME/.local/share/omarchy}"
cmd="export PATH=$(printf '%q' "$OMARCHY_PATH/bin"):\"\$PATH\"; $*; echo; read -n1 -s -r -p 'Done. Press any key to close.'"
term="${HOME}/.config/i3/scripts/i3_term"
if [[ ! -x $term ]]; then
  echo "omarchy-launch-floating-terminal-with-presentation: i3_term not found" >&2
  exit 1
fi

exec "$term" --float -e bash -lc "$cmd"

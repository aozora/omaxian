#!/bin/bash

# omarchy:summary=Decode a QR code from a screenshot region
# omarchy:group=capture
# omarchy:examples=omarchy-capture-qr

if ! omarchy-cmd-present maim zbarimg xclip; then
  omarchy-notification-send -u critical "QR capture unavailable" \
    "Install maim, zbar-tools, and xclip"
  exit 1
fi

IMAGE=$(mktemp --suffix=.png)
trap 'rm -f "$IMAGE"' EXIT

maim -s -u -f png >"$IMAGE" || exit 0
[[ -s $IMAGE ]] || exit 0

# Decode QR codes only. Leaving other symbologies enabled lets dense screen
# content false-positive as an EAN or Code 39 barcode.
RESULT=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$IMAGE" 2>/dev/null)

if [[ -z $RESULT ]]; then
  omarchy-notification-send -g 󰐲 -u critical "No QR code found" \
    "Select a region containing a QR code"
  exit 1
fi

# QR codes routinely carry secrets (otpauth://, Wi-Fi, etc.), so the decoded
# value goes to the clipboard only — never into the notification body.
printf '%s' "$RESULT" | xclip -selection clipboard
omarchy-notification-send -g 󰐲 "QR code copied to clipboard"
